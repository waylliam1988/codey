+def test_lifetimes_controls_deletion_and_source_changes(tmp_path: Path) -> None:
+    store = GhostObservationStore(tmp_path)
+    save(store, "turn", QUOTE)
+    assert not apply(tmp_path, "turn", update(duration="turn"))
+    save(store, "session", QUOTE)
+    apply(tmp_path, "session", update(scope="session", duration="session"))
+    assert INSTRUCTION not in render_collaboration(GhostInboxStore(tmp_path), store, project="", session_id="other")
+    expiry = (datetime.now(UTC) + timedelta(days=1)).isoformat(timespec="seconds")
+    until = f"Until {expiry}, compare reversible choices before recommending one."
+    save(store, "until", until)
+    apply(tmp_path, "until", update(quote=until, condition="", duration="until", expires_at=expiry))
+    assert INSTRUCTION not in render_collaboration(GhostInboxStore(tmp_path), store, project="", session_id="other",
+        now=datetime.now(UTC) + timedelta(days=2))
+    inbox = GhostInboxStore(tmp_path)
+    assert inbox.set_control("admit_hints", False)
+    assert not collaboration_sources(tmp_path, project="", session_id="s", run_id="next")
+    assert inbox.set_control("admit_hints", True)
+    # Source deletion and reconstruction never revive the retired source.
+    store.delete_scope("user")
+    assert INSTRUCTION not in render_collaboration(inbox, store, project="", session_id="s")
+    assert not store.register_input(run_id="until", session_id="s")
+    assert INSTRUCTION not in render_collaboration(inbox, store, project="", session_id="s")
