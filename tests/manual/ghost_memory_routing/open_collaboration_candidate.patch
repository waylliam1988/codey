+"""Project collaboration learning from existing completed provider receipts."""
+from __future__ import annotations
+
+import sqlite3
+from dataclasses import dataclass
+from pathlib import Path
+
+from codey.durable.session import DurableSession
+from codey.ghost.collaboration import (
+    CONTEXT_BUDGET,
+    PREVIOUS_REPLY_PREFIX,
+    SOURCE_KEY,
+    CollaborationUpdate,
+    apply_updates,
+    decode_updates,
+    observations_by_run,
+    render_collaboration,
+)
+from codey.ghost.inbox import GhostInboxStore
+from codey.ghost.observations import GhostObservationStore
+from codey.ghost.payload_types import decoded_object
+from codey.operations.kernel_protocol import normalize_turn
+from codey.operations.provider_receipts import (
+    REQUEST_KIND,
+    RESPONSE_KIND,
+    read_provider_artifact,
+    request_artifact_for_effect,
+    restore_ghost_context,
+    restore_snapshot,
+)
+from codey.protocols.text_turn import decode_text_turn
+from codey.providers.response_record import decode_reply
+from codey.runtime.effects.effect_records import EFFECT_CATEGORY_PROVIDER_SEND, RuntimeEffectStore
+from codey.storage.managed_outputs import ManagedOutputStore
+from codey.workspace.context_admission import GhostContextSource, request_scope
+
+
+def collaboration_sources(home: Path, *, project: str, session_id: str,
+                           run_id: str) -> tuple[GhostContextSource, ...]:
+    try:
+        text = render_collaboration(GhostInboxStore(home), GhostObservationStore(home), project=project,
+                                    session_id=session_id, exclude_run_id=run_id)
+    except (OSError, sqlite3.Error, ValueError, TypeError, OverflowError):
+        return ()
+    return ((GhostContextSource(SOURCE_KEY, text, CONTEXT_BUDGET, request_scope(project, session_id)),)
+            if text else ())
+
+
+def offered_memories(sources: tuple[GhostContextSource, ...]) -> frozenset[str]:
+    """Only exact ids in structured entries of an admitted source are offered."""
+    ids: set[str] = set()
+    for source in sources:
+        if source.key != SOURCE_KEY:
+            continue
+        for line in source.text.splitlines()[1:]:
+            if not line.startswith("{"):
+                continue
+            row = decoded_object(line)
+            identity = row.get("id")
+            if isinstance(identity, str) and isinstance(row.get("request"), str):
+                ids.add(identity)
+    return frozenset(ids)
+
+
+def offered_replies(sources: tuple[GhostContextSource, ...]) -> frozenset[str]:
+    replies: set[str] = set()
+    for source in sources:
+        if source.key != SOURCE_KEY:
+            continue
+        for line in source.text.splitlines():
+            if line.startswith(PREVIOUS_REPLY_PREFIX):
+                reply = decoded_object(line.removeprefix(PREVIOUS_REPLY_PREFIX)).get("reply")
+                if isinstance(reply, str):
+                    replies.add(reply)
+    return frozenset(replies)
+
+
+@dataclass(frozen=True)
+class _Completion:
+    updates: tuple[CollaborationUpdate, ...]
+    sources: tuple[GhostContextSource, ...]
+
+
+def _completion(durable: DurableSession, outputs: ManagedOutputStore, *, session_id: str,
+                 run_id: str, answer: str) -> _Completion | None:
+    """Use the real frozen contract and body; never re-run completion evaluation."""
+    effects = RuntimeEffectStore(durable=durable).load_effects(session_id, run_id)
+    for effect in reversed(effects):
+        if (effect.intent.effect_category != EFFECT_CATEGORY_PROVIDER_SEND or effect.settlement is None
+                or effect.settlement.status != "ok"):
+            continue
+        identity = effect.intent.effect_id
+        responses = [row for row in durable.artifacts_for_effect(identity) if row.metadata.get("kind") == RESPONSE_KIND]
+        if len(responses) != 1:
+            continue
+        request = read_provider_artifact(outputs, request_artifact_for_effect(durable, effect),
+            kind=REQUEST_KIND, session_id=session_id, run_id=run_id, effect_id=identity)
+        if request.get("close_reply"):
+            continue
+        reply = decode_reply(read_provider_artifact(outputs, responses[0], kind=RESPONSE_KIND,
+            session_id=session_id, run_id=run_id, effect_id=identity))
+        plan = normalize_turn(decode_text_turn(reply) if isinstance(reply, str) else reply,
+                              snapshot=restore_snapshot(request.get("snapshot")))
+        if (plan.protocol_error or plan.control is None or plan.control.kind != "done"
+                or plan.control.body != answer):
+            continue
+        _, sources = restore_ghost_context(request.get("context"))
+        return _Completion(decode_updates(plan.control_args.get("collaboration_updates", [])), sources)
+    return None
+
+
+def learn_completed_collaboration(inbox: GhostInboxStore, observations: GhostObservationStore,
+                                  durable: DurableSession, outputs: ManagedOutputStore, *,
+                                  run_id: str, session_id: str, project: str) -> tuple[str, ...]:
+    task = durable.task(run_id)
+    answer = task.state.get("summary")
+    if task.phase != "completed" or task.conversation_id != session_id or not isinstance(answer, str):
+        return ()
+    if not inbox.control_enabled("accept_events", project=project, session_id=session_id):
+        return ()
+    completed = _completion(durable, outputs, session_id=session_id, run_id=run_id, answer=answer)
+    if completed is None or not completed.updates:
+        return ()
+    offered = offered_memories(completed.sources)
+    rows = observations_by_run(observations)
+    feedback_targets: set[tuple[str, str]] = set()
+    positions = {identity: index for index, identity in enumerate(rows)}
+    current_position = positions.get(run_id, -1)
+    for update in completed.updates:
+        if update.action != "feedback":
+            continue
+        prior = rows.get(update.reply)
+        if (prior is None or prior["session_id"] != session_id or prior["project"] != project
+                or positions[update.reply] <= current_position):
+            raise ValueError("feedback target is not an actual earlier same-scope reply")
+        # The model must have been given this reply as an attribution option.
+        if update.reply not in offered_replies(completed.sources):
+            raise ValueError("feedback reply was not offered")
+        old_task = durable.task(update.reply)
+        old_answer = old_task.state.get("summary")
+        if not isinstance(old_answer, str) or old_task.phase != "completed":
+            raise ValueError("feedback reply has no canonical completion")
+        previous = _completion(durable, outputs, session_id=session_id, run_id=update.reply, answer=old_answer)
+        if previous is None or update.target not in offered_memories(previous.sources):
+            raise ValueError("feedback memory was not exposed to the earlier reply")
+        feedback_targets.add((update.target, update.reply))
+    return apply_updates(inbox, observations, run_id=run_id, session_id=session_id, project=project,
+                         updates=completed.updates, offered=offered, feedback_targets=frozenset(feedback_targets))
