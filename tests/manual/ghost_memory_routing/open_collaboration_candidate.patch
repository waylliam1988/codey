+class ReplyProvider:
+    name = "Typed native fixture"
+    location = "fixture://collaboration"
+    native_tools = True
+
+    def __init__(self, respond: Callable[[str], JsonObject]) -> None:
+        self.respond = respond
+        self.requests: list[str] = []
+
+    def new_chat(self, timeout: float | None = None) -> None:
+        pass
+
+    def close(self) -> None:
+        pass
+
+    def send(self, text: str, timeout: float | None = None) -> str:
+        raise AssertionError("native fixture must use send_turn")
+
+    def send_tool_results(self, results: list[ProviderToolResult], tools: list[ProviderToolDefinition] | None = None,
+                          timeout: float | None = None) -> AssistantTurn:
+        raise AssertionError("single completed fixture must not request another generation")
+
+    def acknowledge_tool_results(self, results: list[ProviderToolResult], declared_tools: list[ProviderToolDefinition],
+                                 timeout: float | None = None) -> AssistantTurn:
+        return AssistantTurn()
+
+    def send_turn(self, prompt: str, tools: list[ProviderToolDefinition] | None = None,
+                  timeout: float | None = None, *, tool_call_observations: str = "",
+                  tool_call_history_groups: int = 0, output_token_limit: int = 0,
+                  require_tool_call: bool = False) -> AssistantTurn:
+        self.requests.append(prompt)
+        return AssistantTurn(tool_calls=(ProviderToolCall("done-call", "done", self.respond(prompt)),))
+
+
+def run(state: AppContext, provider: ReplyProvider, *, identity: str, task: str,
+        session: str = "s", project: str | None = None, intent: str = "chat") -> dict[str, object]:
+    request = TaskSubmission(session, project, task, 1, False, "deepseek", intent=intent, run_id=identity)
+    _queue(state).create(identity, {"session_id": session, "project": project, "task": task,
+        "provider": "deepseek", "run_id": identity, "intent": intent, "max_turns": 1, "project_changes_required": False})
+    state.durable.claim_task(identity)
+    state.durable.start_task(identity, state=dict(state.durable.task(identity).state))
+
+    def connect(_identity: str) -> ReplyProvider:
+        return provider
+
+    def availability(_state: object) -> dict[str, bool]:
+        return {}
+
+    with patch.object(provider_services, "provider_availability", availability):
+        run_task_submission(build_task_deps(state, connect_provider=connect), request)
+    assert state.wait_for_ghost_sleep(timeout=10)
+    event: object = state.run_registry.last_terminal_event()
+    assert mapping_fields(event) and event.get("run_id") == identity
+    assert event.get("stop_reason") == "done", json.dumps(event, ensure_ascii=False)
+    return dict(event)
+
