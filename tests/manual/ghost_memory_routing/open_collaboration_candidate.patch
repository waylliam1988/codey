+def test_invalid_batch_rolls_back_and_hypothesis_never_auto_confirms(tmp_path: Path) -> None:
+    store = GhostObservationStore(tmp_path)
+    save(store, "first", QUOTE)
+    with pytest.raises(ValueError, match="preserve user wording"):
