+
+def save(store: GhostObservationStore, run: str, user: str, *, session: str = "s", project: str = "") -> None:
+    assert store.register_input(run_id=run, session_id=session, project=project)
+    assert store.append_completed(run_id=run, session_id=session, project=project, mode="chat",
+        user_text=user, assistant_text="An actual reply.", stop_reason="done", provider_id="test")
+
+
+def update(**changes: object) -> CollaborationUpdate:
+    values: dict[str, object] = {"action": "remember", "quote": QUOTE, "instruction": INSTRUCTION,
+        "condition": CONDITION, "scope": "user", "duration": "ongoing", **changes}
+    return decode_updates([values])[0]
+
+
+def apply(home: Path, run: str, item: CollaborationUpdate, *, session: str = "s", project: str = "",
+           offered: frozenset[str] = frozenset()) -> tuple[str, ...]:
+    return apply_updates(GhostInboxStore(home), GhostObservationStore(home), run_id=run,
+        session_id=session, project=project, updates=(item,), offered=offered, feedback_targets=frozenset())
+
+
+def test_unseen_content_cold_replay_scopes_correction_and_revocation(tmp_path: Path) -> None:
+    store = GhostObservationStore(tmp_path)
+    save(store, "first", QUOTE)
+    identity, = apply(tmp_path, "first", update())
+    # No typed-field enum or manual Accept call is involved.
+    text = render_collaboration(GhostInboxStore(tmp_path), store, project="another-project", session_id="new")
+    assert INSTRUCTION in text and CONDITION in text and identity in text
+    assert not apply(tmp_path, "first", update())
+    assert GhostInboxStore(tmp_path).list_candidates()[0].reinforcement_count == 1
+    revised = "From now on, when exploring layouts, recommend one choice before comparing alternatives."
+    save(store, "second", revised)
+    corrected, = apply(tmp_path, "second", update(action="revise", quote=revised,
+        instruction="recommend one choice before comparing alternatives", target=identity), offered=frozenset({identity}))
+    text = render_collaboration(GhostInboxStore(tmp_path), store, project="", session_id="new")
+    assert "recommend one choice" in text and INSTRUCTION not in text
+    rows = {row.id: row for row in GhostInboxStore(tmp_path).list_candidates()}
+    assert rows[identity].status == "superseded" and rows[identity].superseded_by == corrected
+    save(store, "forget", "Forget that collaboration request.")
+    apply(tmp_path, "forget", update(action="forget", quote="Forget that collaboration request.",
+        instruction="", condition="", target=corrected), offered=frozenset({corrected}))
+    assert "recommend one choice" not in render_collaboration(GhostInboxStore(tmp_path), store, project="", session_id="new")
